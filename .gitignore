# Allowlist: everything is ignored unless listed below.
# Working notes in this directory mention private context and must never be published,
# so the safe default is "not tracked". Add a path here deliberately, never by widening a glob.
/*
!/.gitignore
!/README.md
!/LICENSE
!/ASSERTION_PROVENANCE.md
!/RELATED_WORK_EVIDENCE.md
!/audit/

!/lab/
/lab/*
!/lab/package.json
!/lab/package-lock.json
!/lab/playwright.config.ts
!/lab/conduit-setup.patch

!/lab/support/
/lab/support/*
!/lab/support/fixtures.ts

!/lab/tools/
/lab/tools/*
!/lab/tools/fetch_contract.sh

!/lab/generated/
/lab/generated/*
!/lab/generated/PR_*.spec.ts

!/lab/harness/
/lab/harness/*
!/lab/harness/assertions.py
!/lab/harness/audit_package.py
!/lab/harness/bdd_pipeline.py
!/lab/harness/common.py
!/lab/harness/conditions.py
!/lab/harness/gate2_probe.py
!/lab/harness/gate2_verdict.py
!/lab/harness/gates.py
!/lab/harness/group_probe.py
!/lab/harness/oa_items.py
!/lab/harness/p2_check.py
!/lab/harness/p2_report.py
!/lab/harness/precision_study.py
!/lab/harness/provenance.py
!/lab/harness/run.py
!/lab/harness/sandbox.py

!/lab/runs/
/lab/runs/*
!/lab/runs/precision/
!/lab/runs/p2check/
!/lab/runs/group-probe/
/lab/runs/group-probe/*
!/lab/runs/group-probe/G4_*/
!/lab/runs/group-probe/G5_*/
!/lab/runs/gate2-verdict/
/lab/runs/gate2-verdict/*
!/lab/runs/gate2-verdict/G4_*/
!/lab/runs/gate2-verdict/G5_*/
